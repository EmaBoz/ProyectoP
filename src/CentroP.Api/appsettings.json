{
  "ConnectionStrings": {
    "CentroP": "Server=YOUR_SERVER;Database=CentroP;Trusted_Connection=True;TrustServerCertificate=True;Max Pool Size=200;Min Pool Size=10;Connect Timeout=30;"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "centrorp-inventory",
    "Cufe": "12345"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "AllowedHosts": "*"
}
